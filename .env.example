# Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed
# NEVER commit .env to version control!

# ===========================================
# DATABASE (MySQL)
# ===========================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=shipments
MYSQL_USER=border_user
MYSQL_PASSWORD=your_mysql_password_here

# ===========================================
# BACKEND SECURITY (CRITICAL - Use different keys!)
# ===========================================
# JWT signing key (HS256) - for access tokens
JWT_SECRET_KEY=your_jwt_secret_key_here

# Fernet encryption key - for SFTP password encryption (AES-128)
FERNET_KEY=your_fernet_key_here

# Algorithm for JWT (keep HS256)
ALGORITHM=HS256

# Access token expiry in minutes (30 min default)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# ADMIN USER (Initial setup)
# ===========================================
USER_EMAIL=admin@test.com
USER_PASSWORD=your_admin_password_here

# ===========================================
# SFTP SERVER (for testing)
# ===========================================
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=testSFTP
SFTP_PASS=your_sftp_password_here

# ===========================================
# EMAIL (MailHog for testing)
# ===========================================
MAIL_USERNAME=test
MAIL_PASSWORD=your_mail_password_here
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_FROM=notificaciones@bordercrossing.com

# ===========================================
# FRONTEND (Vite build-time variables)
# ===========================================
VITE_API_URL=http://localhost:8000