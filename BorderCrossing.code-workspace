{
    "folders": [
        {
            "name": "Backend (Python)",
            "path": "backend"
        },
        {
            "name": "Frontend",
            "path": "Frontend"
        },
        {
            "name": "Docker & Configs",
            "path": "."
        }
    ],
    "settings": {
        "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
        "js/ts.validate.enabled": true,

        "files.exclude": {
            "Frontend": true,
            ".agents": true,
            ".fastapicloud": true,
            ".opencode": true,
            ".firebase": true
        },

        "python.defaultInterpreterPath": "${workspaceFolder:Backend (Python)}/.venv/Scripts/python.exe",

        "python.analysis.extraPaths": [
            "${workspaceFolder:Backend (Python)}"
        ],
        "python.analysis.autoSearchPaths": true,

        "console-ninja.toolsToEnableSupportAutomaticallyFor": {
            "live-server-extension": true,
            "live-preview-extension": true
        },
        "js/ts.tsdk.path": "Frontend\\node_modules\\typescript\\lib",
        "reactSnippets.settings.prettierEnabled": false,
        "terminal.integrated.suggest.insertTrailingSpace": true,
        "terminal.integrated.suggest.runOnEnter": "exactMatch",
        "terminal.integrated.suggest.selectionMode": "always",
        "terminal.integrated.suggest.quickSuggestions": {
            "arguments": "on",
            "commands": "on"
        },
        "python.analysis.inlayHints.callArgumentNames": "partial"
    }
}