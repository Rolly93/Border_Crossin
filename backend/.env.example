# Copia este archivo a .env y completa los valores. No subas .env a git.

# ===========================================
# SECURITY - SEPARATE KEYS (CRITICAL)
# ===========================================
# JWT signing key (HS256) - for access tokens
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Fernet encryption key - cifra host, usuario y contraseña SFTP (AES-128)
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡RESPÁLDALA! Si se pierde o cambia, ninguna configuración SFTP se puede leer.
FERNET_KEY=

# Legacy SECRET_KEY (deprecated - use JWT_SECRET_KEY + FERNET_KEY instead)
# SECRET_KEY=

# Algorithm for JWT (keep HS256)
ALGORITHM=HS256

# Access token expiry in minutes (30 min default)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# DATABASE - Elige UNA opción
# ===========================================
# 1) SQLite local (por defecto si no defines nada)
# DB_BACKEND=sqlite
# SQLITE_PATH=./bordercrossing.db

# 2) MySQL
# DB_BACKEND=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=bordercrossing
# DB_USER=usuario
# DB_PASSWORD=contraseña

# 3) PostgreSQL local
# DB_BACKEND=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bordercrossing
# DB_USER=postgres
# DB_PASSWORD=contraseña

# 4) Supabase (SSL obligatorio; usa el host de Project Settings → Database)
# DB_BACKEND=supabase
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=contraseña

# 5) URL completa (gana sobre todo lo anterior)
# DATABASE_URL=postgresql+psycopg2://usuario:contraseña@host:5432/base?sslmode=require

# ===========================================
# Admin inicial
# ===========================================
# init_db no crea ningún administrador. Con la base vacía, la pantalla
# /onetime registra el primer administrador (una sola vez).

# ===========================================
# Correo a clientes y alertas (AWS Lambda + SES)
# ===========================================
# Endpoint de aws/assignation_notifier y su llave (header x-api-key = LAMBDA_API_TOKEN).
# ENDPOINT_AWS=https://<api-id>.execute-api.<region>.amazonaws.com/prod/notify
# APIKEY_AWS=

# ===========================================
# Alertas a soporte (solo errores del servidor, nunca errores del usuario)
# ===========================================
# Nombre de esta instalación en las alertas (por defecto, el nombre del equipo).
# INSTALLATION_NAME=Patio Nuevo Laredo
# Correos de soporte, separados por coma (usan ENDPOINT_AWS/APIKEY_AWS).
# ALERT_EMAILS=soporte@tuempresa.com
#
# WhatsApp Cloud API (Meta). Configuración única:
#   1. App de tipo Business en developers.facebook.com con el producto WhatsApp.
#   2. Número de WhatsApp Business -> su "Phone number ID".
#   3. Token permanente de un usuario del sistema (Business Settings -> System users).
#   4. Plantilla de categoría Utility, aprobada, con 3 variables en el cuerpo, p. ej.:
#      "Error en {{1}}: {{2}}. Hora: {{3}}"   (instalación, #código + error, fecha)
# ALERT_WHATSAPP_TO=5218671234567
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=server_error_alert
# WHATSAPP_TEMPLATE_LANG=es_MX
# Versión vigente de la Graph API (Meta retira versiones; revisa la actual), p. ej. v23.0
# WHATSAPP_API_VERSION=