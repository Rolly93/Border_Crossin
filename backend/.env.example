# Copia este archivo a .env y completa los valores. No subas .env a git.

# ===========================================
# SECURITY - SEPARATE KEYS (CRITICAL)
# ===========================================
# JWT signing key (HS256) - for access tokens
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Fernet encryption key - for SFTP password encryption (AES-128)
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Legacy SECRET_KEY (deprecated - use JWT_SECRET_KEY + FERNET_KEY instead)
# SECRET_KEY=

# Algorithm for JWT (keep HS256)
ALGORITHM=HS256

# Access token expiry in minutes (30 min default)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# DATABASE - Elige UNA opción
# ===========================================
# 1) SQLite local (por defecto si no defines nada)
# DB_BACKEND=sqlite
# SQLITE_PATH=./bordercrossing.db

# 2) MySQL
# DB_BACKEND=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=bordercrossing
# DB_USER=usuario
# DB_PASSWORD=contraseña

# 3) PostgreSQL local
# DB_BACKEND=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bordercrossing
# DB_USER=postgres
# DB_PASSWORD=contraseña

# 4) Supabase (SSL obligatorio; usa el host de Project Settings → Database)
# DB_BACKEND=supabase
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=contraseña

# 5) URL completa (gana sobre todo lo anterior)
# DATABASE_URL=postgresql+psycopg2://usuario:contraseña@host:5432/base?sslmode=require

# ===========================================
# OPTIONAL: Admin User (para init_db)
# ===========================================
# USER_EMAIL=admin@test.com
# USER_PASSWORD=1234